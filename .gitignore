__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store

# 로컬 실험 DB / 내보내기 결과
experiments.db
experiments.db-journal
experiments.db-wal
experiments.db-shm
backups/
*.sqlite
exports/

# 예시 데이터 데모용 - sample_data.populate(with_local_assets=True) 가 만든다.
sample_experiments.db
sample_experiments.db-journal
sample_experiments.db-wal
sample_experiments.db-shm
sample_results/

# 설정 파일 백업/임시본
config/*.yaml.bak
config/*.yaml.tmp

# config/ 아래 "실제로 쓰는" YAML 은 전부 로컬 전용이다 - git 에는 <name>.template.yaml
# 만 들어가고, 앱이 없는 파일을 그 template 을 복사해 만들어 준다(servers.yaml 은
# 실서버 주소가 들어가서 예외 - 자동으로 만들지 않고 직접 복사하게 안내만 한다).
# 새 Task 를 추가하면 tasks/<Task>.yaml 도 여기 걸린다(패턴이 알아서 잡는다).
config/options.yaml
config/defaults.yaml
config/params.yaml
config/servers.yaml
config/tasks/*.yaml
!config/tasks/*.template.yaml

# uv 환경
.python-version
pyproject.toml
*.bak